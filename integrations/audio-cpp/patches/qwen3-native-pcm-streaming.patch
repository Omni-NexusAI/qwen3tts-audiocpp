+runtime::AudioBuffer Qwen3SpeechTokenizerDecoderRuntime::decode_padded(
+    const Qwen3SpeechCodes & codec_codes,
+    int64_t graph_capacity_frames) const {
+    if (codec_codes.frames <= 0 || graph_capacity_frames < codec_codes.frames ||
+        graph_capacity_frames > kChunkCodes || codec_codes.code_groups != weights_->config.num_quantizers ||
+        static_cast<int64_t>(codec_codes.codes.size()) != codec_codes.frames * codec_codes.code_groups) {
