+    Qwen3SpeechCodes pending;
+    pending.code_groups = accumulated.code_groups;
+    runtime::AudioBuffer merged_audio;
+    merged_audio.sample_rate = 24000;
+    merged_audio.channels = 1;
+    bool emitted_first_block = false;
+    int64_t emitted_blocks = 0;
+    double decoder_ms = 0.0;
+
+    const auto append_codes = [](Qwen3SpeechCodes & dst, const Qwen3SpeechCodes & src) {
+        if (src.frames <= 0) {
+            return;
+        }
+        if (dst.code_groups == 0) {
+            dst.code_groups = src.code_groups;
+        }
+        if (dst.code_groups != src.code_groups) {
+            throw std::runtime_error("Qwen3 native PCM stream codec group mismatch");
+        }
+        dst.codes.insert(dst.codes.end(), src.codes.begin(), src.codes.end());
+        dst.frames += src.frames;
