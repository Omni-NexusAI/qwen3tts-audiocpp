     require_prepared("Qwen3 TTS run");
+    if (task_.mode != runtime::RunMode::Offline) {
+        throw std::runtime_error("Qwen3 TTS offline run called for a streaming session");
+    }
+    if (const auto mode = runtime::find_option(request.options, {kDecodeModeOption});
+        mode.has_value() && *mode != kOfflineFullMode) {
+        throw std::runtime_error("Qwen3 TTS offline sessions only support qwen3_tts.decode_mode=offline_full");
+    }
+    auto result = run_offline_request(request);
+    attach_decode_mode(result, "offline-full-decoder");
+    return result;
+}
