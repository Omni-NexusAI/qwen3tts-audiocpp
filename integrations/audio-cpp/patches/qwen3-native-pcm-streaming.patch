+// The decoder is two causal stages.  The transformer stage attends
+// `sliding_window` frames back in every layer, so its reach is many times the
+// window.  The vocoder stage is convolutional and looks back a fixed, short
+// distance.  Streaming splits the graph between them so that the transformer
+// can see the same history as the offline decode while the expensive vocoder
+// only runs on new frames.
+enum class DecoderGraphPart {
+    Full,
+    Transformer,
+    Vocoder,
+};
+
+int64_t causal_conv_lookback_steps(const Conv1dWeights & conv) {
+    return (conv.kernel - 1) * conv.dilation + 1 - conv.stride;
+}
+
+int64_t causal_conv_transpose_lookback_steps(const ConvTranspose1dWeights & conv) {
+    // After the right trim, output n is built from inputs floor(n / stride)
+    // down to floor(n / stride) - (ceil(kernel / stride) - 1).
+    return (conv.kernel + conv.stride - 1) / conv.stride - 1;
+}
+
+// Waveform samples before a frame boundary that can still change the audio
+// after it, summed over every causal convolution of the vocoder stage.
+int64_t vocoder_lookback_samples(const Qwen3SpeechTokenizerDecoderWeights & weights) {
+    int64_t samples_per_step = kDecodeSamplesPerCode;
+    int64_t lookback = 0;
+    for (const auto & stage : weights.upsample_stages) {
+        lookback += causal_conv_transpose_lookback_steps(stage.upconv) * samples_per_step;
+        samples_per_step /= stage.upconv.stride;
+        lookback += causal_conv_lookback_steps(stage.convnext.dwconv) * samples_per_step;
+    }
+    lookback += causal_conv_lookback_steps(weights.decoder_input_conv) * samples_per_step;
+    for (const auto & block : weights.decoder_blocks) {
+        lookback += causal_conv_transpose_lookback_steps(block.upconv) * samples_per_step;
+        samples_per_step /= block.upconv.stride;
+        for (const auto & unit : block.residual_units) {
+            lookback += causal_conv_lookback_steps(unit.conv1) * samples_per_step;
+            lookback += causal_conv_lookback_steps(unit.conv2) * samples_per_step;
+        }
+    }
+    lookback += causal_conv_lookback_steps(weights.output_conv) * samples_per_step;
+    if (samples_per_step != 1) {
+        throw std::runtime_error("Qwen3 speech decoder upsampling does not match the codec frame size");
+    }
+    return lookback;
