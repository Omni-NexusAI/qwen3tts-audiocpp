+                "qwen3_tts.speech_tokenizer_decoder.vocoder_constants",
+                part_constant_bytes);
+        }
+        vocoder_graph_ = std::make_unique<Qwen3SpeechTokenizerDecoderGraph>(
+            weights_, vocoder_capacity, *execution_context_, *vocoder_constants_, graph_arena_bytes_,
+            perf_mode_, DecoderGraphPart::Vocoder);
+        graph_build_ms += engine::debug::elapsed_ms(build_start, Clock::now());
+    }
+
+    const size_t groups = static_cast<size_t>(history.code_groups);
+    const size_t latent_dim = static_cast<size_t>(weights_->config.latent_dim);
+    std::vector<float> samples;
+    samples.reserve(static_cast<size_t>(target_frames * kDecodeSamplesPerCode));
+    double transformer_ms = 0.0;
+    double vocoder_ms = 0.0;
+    int64_t begin = history.frames - target_frames;
+    while (begin < history.frames) {
+        // Reproduce decode(): frame `begin` belongs to one 300-frame chunk,
+        // and that chunk is decoded from its own start (plus 25 frames of
+        // overlap for every chunk after the first).  The transformer runs on
+        // exactly that window, so its rows equal the offline rows.
+        const int64_t chunk_begin = (begin / kChunkCodes) * kChunkCodes;
+        const int64_t chunk_end = std::min<int64_t>(chunk_begin + kChunkCodes, history.frames);
+        const int64_t chunk_context = chunk_begin > kLeftContextCodes ? kLeftContextCodes : chunk_begin;
+        const int64_t window_begin = chunk_begin - chunk_context;
+        const auto latent = transformer_graph_->run_transformer(
+            history.codes.data() + static_cast<size_t>(window_begin) * groups,
+            static_cast<size_t>(chunk_end - window_begin) * groups);
+        transformer_ms += transformer_graph_->last_graph_compute_ms();
+        while (begin < chunk_end) {
+            const int64_t end = std::min<int64_t>(chunk_end, begin + max_block_frames);
+            // The vocoder cannot see further back than `vocoder_context`
+            // frames, so rows before that do not affect the kept samples.
+            const int64_t vocoder_begin = std::max<int64_t>(window_begin, begin - vocoder_context);
+            const auto decoded = vocoder_graph_->run_vocoder(
+                latent.data() + static_cast<size_t>(vocoder_begin - window_begin) * latent_dim,
+                end - vocoder_begin);
+            vocoder_ms += vocoder_graph_->last_graph_compute_ms();
+            samples.insert(
+                samples.end(),
+                decoded.begin() + static_cast<std::ptrdiff_t>((begin - vocoder_begin) * kDecodeSamplesPerCode),
+                decoded.begin() + static_cast<std::ptrdiff_t>((end - vocoder_begin) * kDecodeSamplesPerCode));
+            begin = end;
+        }
+    }
+    debug::timing_log_scalar("qwen3_tts.speech_decoder.stream.graph.build_ms", graph_build_ms);
+    debug::timing_log_scalar("qwen3_tts.speech_decoder.stream.transformer_ms", transformer_ms);
+    debug::timing_log_scalar("qwen3_tts.speech_decoder.stream.vocoder_ms", vocoder_ms);
+    debug::timing_log_scalar("qwen3_tts.speech_decoder.stream.vocoder_context_frames", vocoder_context);
+    return runtime::AudioBuffer{kSampleRate, 1, std::move(samples)};
+}
+
+runtime::AudioBuffer Qwen3SpeechTokenizerDecoderRuntime::decode_padded(
+    const Qwen3SpeechCodes & codec_codes,
+    int64_t graph_capacity_frames) const {
+    if (codec_codes.frames <= 0 || graph_capacity_frames < codec_codes.frames ||
+        graph_capacity_frames > kChunkCodes || codec_codes.code_groups != weights_->config.num_quantizers ||
+        static_cast<int64_t>(codec_codes.codes.size()) != codec_codes.frames * codec_codes.code_groups) {
+        throw std::runtime_error("Qwen3 speech decoder received invalid padded codec shape");
+    }
+    const int threads = std::max(1, execution_context_->config().threads);
+    if (graph_ == nullptr || !graph_->matches(*weights_, graph_capacity_frames, execution_context_->backend(), threads)) {
+        graph_.reset();
+        graph_ = std::make_unique<Qwen3SpeechTokenizerDecoderGraph>(
+            weights_, graph_capacity_frames, *execution_context_, *constants_, graph_arena_bytes_, perf_mode_);
+    }
+    // The graph is shaped by `graph_capacity_frames`, not this call's valid
+    // tail.  Keep first, steady and final blocks on that one fixed shape: a
+    // short EOS tail is padded with codec-zero frames and trimmed below before
+    // it is exposed to the caller.  Rebuilding here would turn every tail
+    // size into a separate CUDA graph and reintroduce cadence stalls.
+    std::vector<int32_t> padded_codes(
+        static_cast<size_t>(graph_capacity_frames * codec_codes.code_groups),
+        0);
+    std::copy(codec_codes.codes.begin(), codec_codes.codes.end(), padded_codes.begin());
+    auto decoded = graph_->run(padded_codes.data(), padded_codes.size());
+    const size_t valid_samples = static_cast<size_t>(codec_codes.frames * kDecodeSamplesPerCode);
+    if (decoded.size() < valid_samples) {
+        throw std::runtime_error("Qwen3 padded decoder output is shorter than valid input");
+    }
+    decoded.resize(valid_samples);
+    return runtime::AudioBuffer{kSampleRate, 1, std::move(decoded)};
+}
