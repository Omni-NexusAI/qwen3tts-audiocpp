+        text_tokenizer_,
+        *speech_encoder_,
+        *speaker_encoder_,
+        assets_->config.talker.max_position_embeddings);
+    const auto prompt_start = Clock::now();
+    const auto & voice_prompt = resolve_voice_prompt(*qwen_request.voice_clone, prompt_builder);
+    const double prompt_ms = engine::debug::elapsed_ms(prompt_start, Clock::now());
+    if (!voice_prompt.reference_codes.has_value()) {
+        throw std::runtime_error("Qwen3 native PCM streaming currently requires full ICL clone conditioning");
+    }
+    const auto prefill_start = Clock::now();
+    const auto prefill = prompt_builder.build_prefill(qwen_request, voice_prompt);
+    const double prefill_ms = engine::debug::elapsed_ms(prefill_start, Clock::now());
+
+    const auto parse_block_frames = [&](const char * key, int64_t fallback) {
+        const auto value = runtime::parse_i64_option(request.options, {key});
+        const int64_t frames = value.value_or(fallback);
+        if (frames <= 0 || frames > 300) {
+            throw std::runtime_error(std::string(key) + " must be between 1 and 300 codec frames");
+        }
+        return frames;
+    };
+    const int64_t first_block_frames = parse_block_frames("qwen3_tts.stream_first_block_frames", 4);
+    const int64_t steady_block_frames = parse_block_frames("qwen3_tts.stream_steady_block_frames", 12);
+    const int64_t left_context_frames = parse_block_frames("qwen3_tts.stream_left_context_frames", 72);
