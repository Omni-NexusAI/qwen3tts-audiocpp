+runtime::TaskResult Qwen3TTSSession::run_streaming_base_request(const runtime::TaskRequest & request) {
+    if (assets_->config.variant != Qwen3TTSVariant::Base) {
+        throw std::runtime_error("Qwen3 TTS native PCM streaming is available for Base clone models only");
+    }
+    if (speech_encoder_ == nullptr || speaker_encoder_ == nullptr) {
+        throw std::runtime_error("Qwen3 base TTS session is missing voice clone runtimes");
+    }
+    const auto wall_start = Clock::now();
+    const int64_t text_chunk_size =
+        engine::text::parse_text_chunk_size_override(request.options).value_or(kDefaultTextChunkSize);
+    const auto chunk_requests = runtime::chunk_text_request(request, text_chunk_size);
+    if (chunk_requests.size() != 1) {
+        throw std::runtime_error("Qwen3 native PCM streaming requires one stable text phrase per request");
+    }
+    const Qwen3TTSRequest qwen_request = make_request(chunk_requests.front());
+    if (!qwen_request.voice_clone.has_value()) {
+        throw std::runtime_error("Qwen3 native PCM streaming requires Base clone reference audio");
+    }
