+                throw std::runtime_error("Qwen3 native PCM stream decoder context exceeds output");
+            }
+            audio.samples.erase(audio.samples.begin(), audio.samples.begin() + static_cast<std::ptrdiff_t>(drop_samples));
+        }
+        decoder_ms += engine::debug::elapsed_ms(decoder_start, Clock::now());
