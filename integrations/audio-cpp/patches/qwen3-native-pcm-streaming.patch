+};
+
+std::optional<Qwen3GenerationTelemetry> qwen3_generation_telemetry(
+    const std::vector<engine::runtime::VoiceArtifact> & artifacts) {
+    for (const auto & artifact : artifacts) {
+        if (artifact.id != "qwen3_tts.generation") continue;
+        const auto frames = artifact.meta.find("generated_frames");
+        const auto cap = artifact.meta.find("generation_cap");
+        const auto termination = artifact.meta.find("termination");
+        const auto prompt_ms = artifact.meta.find("prompt_ms");
+        const auto prefill_ms = artifact.meta.find("prefill_ms");
+        const auto talker_ms = artifact.meta.find("talker_ms");
+        const auto decoder_ms = artifact.meta.find("decoder_ms");
+        if (frames == artifact.meta.end() || cap == artifact.meta.end() ||
+            termination == artifact.meta.end() || prompt_ms == artifact.meta.end() ||
+            prefill_ms == artifact.meta.end() || talker_ms == artifact.meta.end() ||
+            decoder_ms == artifact.meta.end()) return std::nullopt;
+        Qwen3GenerationTelemetry telemetry{
+            frames->second, cap->second, termination->second, prompt_ms->second,
+            prefill_ms->second, talker_ms->second, decoder_ms->second};
+        const auto optional_meta = [&](const char * key, std::string & out) {
+            const auto found = artifact.meta.find(key);
+            if (found != artifact.meta.end()) out = found->second;
+        };
+        optional_meta("prompt_rows", telemetry.prompt_rows);
+        optional_meta("prompt_prefill_ms", telemetry.prompt_prefill_ms);
+        optional_meta("prompt_import_ms", telemetry.prompt_import_ms);
+        optional_meta("first_frame_ms", telemetry.first_frame_ms);
+        optional_meta("stream_decoder", telemetry.stream_decoder);
+        return telemetry;
+    }
+    return std::nullopt;
+}
+
+void attach_qwen3_generation_headers(HttpResponse & response, const engine::runtime::TaskResult & result) {
+    const auto telemetry = qwen3_generation_telemetry(result.output_artifacts);
+    if (!telemetry.has_value()) return;
+    response.headers.emplace("X-AudioCPP-Generated-Frames", telemetry->generated_frames);
+    response.headers.emplace("X-AudioCPP-Generation-Cap", telemetry->generation_cap);
+    response.headers.emplace("X-AudioCPP-Termination", telemetry->termination);
+    // Completed responses have no event channel, so stage timings travel as
+    // headers.  They are the same values the stream reports in
+    // speech.generation.
+    response.headers.emplace("X-AudioCPP-Prompt-Ms", telemetry->prompt_ms);
+    response.headers.emplace("X-AudioCPP-Prefill-Ms", telemetry->prefill_ms);
+    response.headers.emplace("X-AudioCPP-Talker-Ms", telemetry->talker_ms);
+    response.headers.emplace("X-AudioCPP-Decode-Ms", telemetry->decoder_ms);
+    response.headers.emplace("X-AudioCPP-Prompt-Rows", telemetry->prompt_rows);
+    response.headers.emplace("X-AudioCPP-Prompt-Prefill-Ms", telemetry->prompt_prefill_ms);
+    response.headers.emplace("X-AudioCPP-Prompt-Import-Ms", telemetry->prompt_import_ms);
+    response.headers.emplace("X-AudioCPP-First-Frame-Ms", telemetry->first_frame_ms);
+}
