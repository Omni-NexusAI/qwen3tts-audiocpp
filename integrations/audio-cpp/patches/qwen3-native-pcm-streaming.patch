+    auto decoded = graph_->run(codec_codes.codes.data(), codec_codes.codes.size());
+    const size_t valid_samples = static_cast<size_t>(codec_codes.frames * kDecodeSamplesPerCode);
+    if (decoded.size() < valid_samples) {
+        throw std::runtime_error("Qwen3 padded decoder output is shorter than valid input");
+    }
+    decoded.resize(valid_samples);
+    return runtime::AudioBuffer{kSampleRate, 1, std::move(decoded)};
