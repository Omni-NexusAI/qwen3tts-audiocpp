+std::optional<std::string> qwen3_decode_mode_artifact(
+    const std::vector<engine::runtime::VoiceArtifact> & artifacts) {
+    for (const auto & artifact : artifacts) {
+        if (artifact.id != "qwen3_tts.decode_mode") {
+            continue;
+        }
+        const auto mode = artifact.meta.find("mode");
+        if (mode != artifact.meta.end() && !mode->second.empty()) {
+            return mode->second;
+        }
+    }
+    return std::nullopt;
+}
