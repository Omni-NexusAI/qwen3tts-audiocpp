+
+runtime::TaskResult Qwen3TTSSession::run_streaming_base_request(const runtime::TaskRequest & request) {
+    if (assets_->config.variant != Qwen3TTSVariant::Base) {
+        throw std::runtime_error("Qwen3 TTS native PCM streaming is available for Base clone models only");
+    }
+    if (speech_encoder_ == nullptr || speaker_encoder_ == nullptr) {
+        throw std::runtime_error("Qwen3 base TTS session is missing voice clone runtimes");
+    }
+    const auto wall_start = Clock::now();
+    const int64_t text_chunk_size =
+        engine::text::parse_text_chunk_size_override(request.options).value_or(kDefaultTextChunkSize);
+    const auto chunk_requests = runtime::chunk_text_request(request, text_chunk_size);
+    if (chunk_requests.size() != 1) {
+        throw std::runtime_error("Qwen3 native PCM streaming requires one stable text phrase per request");
+    }
+    const Qwen3TTSRequest qwen_request = make_request(chunk_requests.front());
+    if (!qwen_request.voice_clone.has_value()) {
+        throw std::runtime_error("Qwen3 native PCM streaming requires Base clone reference audio");
+    }
+    Qwen3TTSVoiceClonePromptBuilder prompt_builder(
+        text_tokenizer_,
+        *speech_encoder_,
+        *speaker_encoder_,
+        assets_->config.talker.max_position_embeddings);
+    const auto prompt_start = Clock::now();
+    const auto & voice_prompt = resolve_voice_prompt(*qwen_request.voice_clone, prompt_builder);
+    const double prompt_ms = engine::debug::elapsed_ms(prompt_start, Clock::now());
+    if (!voice_prompt.reference_codes.has_value()) {
+        throw std::runtime_error("Qwen3 native PCM streaming currently requires full ICL clone conditioning");
+    }
+    const auto prefill_start = Clock::now();
+    auto prefill = prompt_builder.build_prefill(qwen_request, voice_prompt);
+    attach_clone_cache_identity(prefill, *qwen_request.voice_clone);
+    const double prefill_ms = engine::debug::elapsed_ms(prefill_start, Clock::now());
+
+    const auto parse_block_frames = [&](const char * key, int64_t fallback) {
+        const auto value = runtime::parse_i64_option(request.options, {key});
+        const int64_t frames = value.value_or(fallback);
+        if (frames <= 0 || frames > 300) {
+            throw std::runtime_error(std::string(key) + " must be between 1 and 300 codec frames");
+        }
+        return frames;
+    };
+    const int64_t first_block_frames = parse_block_frames("qwen3_tts.stream_first_block_frames", 4);
+    const int64_t steady_block_frames = parse_block_frames("qwen3_tts.stream_steady_block_frames", 12);
+    // Only the windowed decoder uses this context.  25 frames is upstream's
+    // chunk overlap, not the decoder's reach: the decoder transformer attends
+    // 72 frames back in each of its layers, which is why a windowed block
+    // never equals the offline decode.  The default decoder below does not
+    // window the transformer at all.
+    const int64_t left_context_frames = parse_block_frames("qwen3_tts.stream_left_context_frames", 25);
+    const auto stream_decoder = stream_decoder_from_request(request);
+    const int64_t max_block_frames = std::max(first_block_frames, steady_block_frames);
+    const int64_t decoder_capacity_frames = left_context_frames + std::max(
+        first_block_frames, steady_block_frames);
+    if (decoder_capacity_frames > 300) {
+        throw std::runtime_error("qwen3_tts.stream_left_context_frames + max(stream_first_block_frames, stream_steady_block_frames) must not exceed 300 codec frames");
+    }
+    // Clone conditioning may be cached, but there is no decoder-state
+    // continuity between phrase requests. Only complete frames from this
+    // request are delivered through the streaming sink.
+    if (runtime::parse_i64_option(request.options, {"qwen3_tts.stream_crossfade_samples"}).value_or(0) != 0) {
+        throw std::runtime_error(
+            "qwen3_tts.stream_crossfade_samples is not applicable: the causal decoder emits contiguous PCM using retained left context");
+    }
+
+    Qwen3SpeechCodes accumulated = *voice_prompt.reference_codes;
+    Qwen3SpeechCodes pending;
+    pending.code_groups = accumulated.code_groups;
+    runtime::AudioBuffer merged_audio;
+    merged_audio.sample_rate = 24000;
+    merged_audio.channels = 1;
+    bool emitted_first_block = false;
+    int64_t emitted_blocks = 0;
+    double decoder_ms = 0.0;
+
+    const auto append_codes = [](Qwen3SpeechCodes & dst, const Qwen3SpeechCodes & src) {
+        if (src.frames <= 0) {
+            return;
+        }
+        if (dst.code_groups == 0) {
+            dst.code_groups = src.code_groups;
+        }
+        if (dst.code_groups != src.code_groups) {
+            throw std::runtime_error("Qwen3 native PCM stream codec group mismatch");
+        }
+        dst.codes.insert(dst.codes.end(), src.codes.begin(), src.codes.end());
+        dst.frames += src.frames;
+    };
+    const auto emit_pending = [&]() {
+        if (pending.frames == 0) {
+            return;
+        }
+        runtime::AudioBuffer audio;
+        const auto decoder_start = Clock::now();
+        if (stream_decoder == Qwen3StreamDecoder::OfflineMatched) {
+            // `accumulated` is the reference codes followed by every frame
+            // generated so far, which is exactly what the offline path hands
+            // to decode_and_trim_reference.  The decoder returns the offline
+            // samples for the pending frames without decoding the rest again.
+            audio = speech_decoder_->decode_streaming_block(accumulated, pending.frames, max_block_frames);
+        } else {
+        // First, steady, and EOS-tail blocks use one padded causal decoder
+        // capacity.  Only the final causal reference window is decoded; the
+        // exact context samples are discarded after decoding.
+        const int64_t context_frames = std::min<int64_t>(
+            left_context_frames,
+            accumulated.frames - pending.frames);
+        Qwen3SpeechCodes decoder_input;
+        decoder_input.code_groups = accumulated.code_groups;
+        decoder_input.frames = context_frames + pending.frames;
+        const size_t context_offset = static_cast<size_t>(
+            (accumulated.frames - pending.frames - context_frames) * accumulated.code_groups);
+        decoder_input.codes.insert(
+            decoder_input.codes.end(),
+            accumulated.codes.begin() + static_cast<std::ptrdiff_t>(context_offset),
+            accumulated.codes.end());
+        audio = speech_decoder_->decode_padded(decoder_input, decoder_capacity_frames);
+        const int64_t drop_samples = context_frames * 1920;
+        if (drop_samples > static_cast<int64_t>(audio.samples.size())) {
+            throw std::runtime_error("Qwen3 native PCM stream decoder context exceeds output");
+        }
+        audio.samples.erase(audio.samples.begin(), audio.samples.begin() + static_cast<std::ptrdiff_t>(drop_samples));
+        }
+        emitted_first_block = true;
+        decoder_ms += engine::debug::elapsed_ms(decoder_start, Clock::now());
+        runtime::append_audio_buffer(merged_audio, audio);
+        if (stream_event_sink_) {
+            runtime::StreamEvent event;
+            // The HTTP server relays this engine-owned artifact before the
+            // first PCM delta. It is proof of the actual session mode, not a
+            // supervisor inference from request metadata.
+            attach_decode_mode(event, "native-incremental-pcm");
+            event.audio_output = std::move(audio);
+            stream_event_sink_(event);
+        }
+        pending.codes.clear();
+        pending.frames = 0;
+        ++emitted_blocks;
+    };
+
+    const auto talker_start = Clock::now();
+    const auto codes = [&]() {
+        try {
+            return talker_step_->generate(
+                prefill,
+                qwen_request.generation,
+                qwen_request.generation.repetition_penalty,
+                [&](const Qwen3SpeechCodes & frame) {
+                    append_codes(accumulated, frame);
+                    append_codes(pending, frame);
+                    const int64_t target = emitted_first_block ? steady_block_frames : first_block_frames;
+                    if (pending.frames >= target) {
+                        emit_pending();
+                    }
+                });
+        } catch (...) {
+            // Socket callbacks are permitted to abort the monolithic generate
+            // call.  Do not decode/emit an EOS tail after that abort, and leave
+            // the session reusable for the next independent request.
+            debug::timing_log_scalar("qwen3_tts.generation_cancelled", 1.0);
+            reset();
+            throw;
+        }
+    }();
+    const double talker_ms = engine::debug::elapsed_ms(talker_start, Clock::now());
+    // Only EOS has a valid final causal tail. A generation-cap exit is not complete.
+    if (codes.termination == Qwen3GenerationTermination::Eos) {
+        emit_pending();
+    } else {
+        pending.codes.clear();
+        pending.frames = 0;
+    }
+    if (mem_saver_) {
+        (void)talker_step_->release_cached_step_graph();
+    }
+    runtime::TaskResult result;
+    result.audio_output = std::move(merged_audio);
+    record_generation_metrics(codes, decoder_ms);
+    TalkerStageTimings stages;
+    stages.add(codes);
+    attach_generation_telemetry(
+        result, codes.generated_codes.frames, codes.generation_cap, codes.termination,
+        prompt_ms, prefill_ms, talker_ms, decoder_ms, stages,
+        stream_decoder == Qwen3StreamDecoder::OfflineMatched ? "offline-matched" : "windowed");
+    debug::timing_log_scalar("qwen3_tts.native_streaming", 1.0);
+    debug::timing_log_scalar(
+        "qwen3_tts.stream_decoder_offline_matched",
+        stream_decoder == Qwen3StreamDecoder::OfflineMatched ? 1.0 : 0.0);
+    debug::timing_log_scalar("qwen3_tts.stream_blocks", static_cast<double>(emitted_blocks));
+    debug::timing_log_scalar("qwen3_tts.stream_first_block_frames", static_cast<double>(first_block_frames));
+    debug::timing_log_scalar("qwen3_tts.stream_steady_block_frames", static_cast<double>(steady_block_frames));
+    debug::timing_log_scalar("qwen3_tts.stream_left_context_frames", static_cast<double>(left_context_frames));
+    debug::timing_log_scalar("qwen3_tts.voice_prompt_ms", prompt_ms);
+    debug::timing_log_scalar("qwen3_tts.prefill_build_ms", prefill_ms);
+    debug::timing_log_scalar("qwen3_tts.talker_ms", talker_ms);
+    debug::timing_log_scalar("qwen3_tts.speech_decoder_ms", decoder_ms);
+    debug::timing_log_scalar("session.wall_ms", engine::debug::elapsed_ms(wall_start, Clock::now()));
+    return result;
+}
