+Qwen3StreamDecoder stream_decoder_from_request(const runtime::TaskRequest & request) {
+    const auto value = runtime::find_option(request.options, {kStreamDecoderOption});
+    if (!value.has_value() || *value == kOfflineMatchedStreamDecoder) {
+        return Qwen3StreamDecoder::OfflineMatched;
+    }
+    if (*value == kWindowedStreamDecoder) {
+        return Qwen3StreamDecoder::Windowed;
